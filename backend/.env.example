# ==========================================================================
# COPD Explorer Backend – Environment Variable Reference
# ==========================================================================
# Copy this file to .env and fill in values for your local environment.
# NEVER commit .env to the repository.  NEVER put real API keys in this file.
# ==========================================================================

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# CORS – comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:4174

# AI Provider: "mock" (deterministic fixtures) or "deepseek" (real API)
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=30

# DeepSeek API Key – ONLY set this in your runtime environment, NEVER here.
# DEEPSEEK_API_KEY=sk-your-key-here
